{
  "name": "deadfall-square",
  "private": true,
  "version": "1.0.0",
  "description": "Low-poly 3D zombie wave-survival game for the browser (Three.js + Vite + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/three": "0.180.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
