local KINDS = { "skin", "trail", "emote", "title" }

type RngLike = { next: (any) -> number }

-- A fresh profile; `scrip` is the starting balance (only non-zero for offline Studio tests).
local function newProfile(scrip: number?): Profile
	return { scrip = scrip or 0, highestTier = 0, wins = 0, owned = {}, equipped = { emotes = {} } }
end

-- Repairs whatever came out of storage into a valid profile (unknown items are dropped).
local function normalize(raw: any, startScrip: number?): Profile
	if type(raw) ~= "table" then
		return newProfile(startScrip)
	end
	local p = newProfile(0)
	p.scrip = if type(raw.scrip) == "number" then math.max(0, math.floor(raw.scrip)) else 0
	p.highestTier = if type(raw.highestTier) == "number"
		then math.clamp(math.floor(raw.highestTier), 0, Tiers.MAX)
		else 0
	p.wins = if type(raw.wins) == "number" then math.max(0, math.floor(raw.wins)) else 0
	if type(raw.owned) == "table" then
		for id, v in raw.owned do
			if v == true and ITEMS[id] then
				p.owned[id] = true
			end
		end
	end
	local e = if type(raw.equipped) == "table" then raw.equipped else {}
	for _, kind in { "skin", "trail", "title" } do
		local id = e[kind]
		if type(id) == "string" and p.owned[id] and ITEMS[id].kind == kind then
			(p.equipped :: any)[kind] = id
		end
	end
	if type(e.emotes) == "table" then
		for _, id in e.emotes do
			if
				type(id) == "string"
				and p.owned[id]
				and ITEMS[id].kind == "emote"
				and not table.find(p.equipped.emotes, id)
				and #p.equipped.emotes < EMOTE_SLOTS
			then
				table.insert(p.equipped.emotes, id)
			end
		end
	end
	return p
end

-- The highest tier this player may pick: one above their best win.
local function unlockedTier(p: Profile): number
	return math.min(Tiers.MAX, p.highestTier + 1)
end

-- Rolls a crate for someone owning `owned`: an item id, or nil if they own everything.
local function rollCrate(rng: RngLike, owned: { [string]: boolean }): string?
	local r = rng:next()
	local start = #RARITY_ORDER
	local acc = 0
	for i, rarity in RARITY_ORDER do
		acc += RARITIES[rarity].odds
		if r < acc then
			start = i
			break
		end
	end
	-- That rarity, or the next one up (then down) with something left to give.
	local tryOrder = {}
	for i = start, #RARITY_ORDER do
		table.insert(tryOrder, RARITY_ORDER[i])
	end
	for i = start - 1, 1, -1 do
		table.insert(tryOrder, RARITY_ORDER[i])
	end
	for _, rarity in tryOrder do
		local pool = {}
		for _, id in ORDER do
			if ITEMS[id].rarity == rarity and not owned[id] then
				table.insert(pool, id)
			end
		end
		if #pool > 0 then
			return pool[math.floor(rng:next() * #pool) + 1]
		end
	end
	return nil
end

--[[
	Buys and opens a crate. Returns (true, itemId) or (true, nil) with a full
	refund when everything is owned, or (false, reason).
]]
local function buyCrate(p: Profile, rng: RngLike): (boolean, string?)
	if p.scrip < CRATE_PRICE then
		return false, "Not enough Scrip"
	end
	local id = rollCrate(rng, p.owned)
	if not id then
		return true, nil -- nothing left to win: no charge
	end
	p.scrip -= CRATE_PRICE
	p.owned[id] = true
	-- A first item of a kind is equipped straight away.
	local it = ITEMS[id]
	if it.kind == "emote" then
		if #p.equipped.emotes < EMOTE_SLOTS then
			table.insert(p.equipped.emotes, id)
		end
	elseif (p.equipped :: any)[it.kind] == nil then
		(p.equipped :: any)[it.kind] = id
	end
	return true, id
end

--[[
	Equips an owned item (or, for skins / trails / titles, `id = nil` clears the
	slot). Emotes toggle in and out of the emote menu (up to EMOTE_SLOTS).
]]
local function equip(p: Profile, kind: string, id: string?): boolean
	if not table.find(KINDS, kind) then
		return false
	end
	if id ~= nil and (not ITEMS[id] or ITEMS[id].kind ~= kind or not p.owned[id]) then
		return false
	end
	if kind == "emote" then
		if id == nil then
			return false
		end
		local i = table.find(p.equipped.emotes, id)
		if i then
			table.remove(p.equipped.emotes, i)
		elseif #p.equipped.emotes < EMOTE_SLOTS then
			table.insert(p.equipped.emotes, id)
		else
			return false
		end
		return true
	end
	(p.equipped :: any)[kind] = id
	return true
end

-- Scrip for a boss killed on `tier`. Returns the amount.
local function applyBoss(p: Profile, tier: number): number
	local amount = Tiers.get(tier).scripBoss
	p.scrip += amount
	return amount
end

-- A climb won on `tier`: Scrip, a win, and the next tier unlocked. Returns the amount.
local function applyWin(p: Profile, tier: number): number
	local t = Tiers.get(tier)
	p.scrip += t.scripWin
	p.wins += 1
	p.highestTier = math.max(p.highestTier, t.tier)
	return t.scripWin
end

return {
	ITEMS = ITEMS,
	ORDER = ORDER,
	KINDS = KINDS,
	RARITIES = RARITIES,
	RARITY_ORDER = RARITY_ORDER,
	CRATE_PRICE = CRATE_PRICE,
	EMOTE_SLOTS = EMOTE_SLOTS,
	newProfile = newProfile,
	normalize = normalize,
	unlockedTier = unlockedTier,
	rollCrate = rollCrate,
	buyCrate = buyCrate,
	equip = equip,
	applyBoss = applyBoss,
	applyWin = applyWin,
}
