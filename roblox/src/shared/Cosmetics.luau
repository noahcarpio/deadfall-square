--!strict
-- String requires below are the Lune (unit test) branch; Roblox uses the Instance branch.
--# selene: allow(incorrect_standard_library_use)
--[[
	Cosmetics and the player profile, as pure rules (no Roblox APIs, unit-
	tested). The DataStore side lives in the server's Profile module, which
	runs these functions inside atomic UpdateAsync transforms.

	Players earn Scrip by beating bosses and winning climbs, and spend it on
	Survivor Crates. A crate rolls a rarity by the published odds, then an item
	of that rarity the player doesn't own yet, so there are no duplicates
	until a whole rarity is collected. Everything here is earned in play:
	there are no paid crates.

	Kinds: weapon skins (recolour every gun and melee weapon), trails (behind
	your character), emotes (keyframed clips from the emote menu) and titles
	(shown under your name).
]]
local Tiers = if script then require(script.Parent.Config.Tiers) else require("./Config/Tiers")

export type Item = {
	id: string,
	kind: string, -- "skin" | "trail" | "emote" | "title"
	name: string,
	rarity: string,
	-- skin: a colour (hex) and material for every weapon part
	color: string?,
	material: string?,
	-- trail: colours from head to tail, how long it lingers and how bright it glows
	colors: { string }?,
	lifetime: number?,
	light: number?,
	-- emote: the keyframed clip in ReplicatedStorage.DeadfallAnimations
	clip: string?,
	loop: boolean?,
}

export type Profile = {
	scrip: number,
	highestTier: number, -- highest tier won (0 = none yet)
	wins: number,
	owned: { [string]: boolean },
	equipped: { skin: string?, trail: string?, title: string?, emotes: { string } },
}

local RARITIES = {
	common = { name = "Common", odds = 0.55, color = "#8a8478" },
	rare = { name = "Rare", odds = 0.30, color = "#2f4a6b" },
	epic = { name = "Epic", odds = 0.12, color = "#6b3f8a" },
	legendary = { name = "Legendary", odds = 0.03, color = "#a9822f" },
}
local RARITY_ORDER = { "common", "rare", "epic", "legendary" }

local CRATE_PRICE = 120
local EMOTE_SLOTS = 4

local ITEMS: { [string]: Item } = {}
local ORDER: { string } = {}
local function item(i: Item)
	ITEMS[i.id] = i
	table.insert(ORDER, i.id)
end

