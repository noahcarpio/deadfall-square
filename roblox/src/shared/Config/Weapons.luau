--!strict
export type WeaponId = string

export type WeaponDef = {
	id: string,
	name: string,
	kind: "hitscan" | "flame" | "grenade",
	damage: number,
	pellets: number,
	fireRate: number,
	spread: number,
	moveSpread: number,
	magSize: number,
	reserveMax: number,
	startReserve: number,
	reloadTime: number,
	range: number,
	pierce: number,
	knockback: number,
	shake: number,
	price: number,
	color: string,
	blastRadius: number?,
	-- Damage multiplier at the edge of range (pellet guns); nil = no falloff.
	falloff: number?,
	-- Burst guns: shots per trigger cycle (fireRate counts cycles) and the gap between them.
	burst: number?,
	burstGap: number?,
	-- Walk-speed multiplier while this gun is held (heavy guns).
	moveSpeed: number?,
	-- Seconds the trigger must be held before the shot goes off.
	charge: number?,
	-- false: not sold by the merchant (found in drops and rewards only).
	merchant: boolean?,
	-- Earliest floor, and lowest rarity, it can roll as gear.
	minFloor: number?,
	minRarity: string?,
	projectileSpeed: number?,
	description: string,
}

